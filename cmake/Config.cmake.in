@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# RT ships a custom FindFilesystem module (installed next to this config); make
# it discoverable so find_dependency(Filesystem) and the std::filesystem
# imported target referenced by rt::core resolve for downstream consumers.
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/Modules")

if(@RT_USE_BOOSTFS@)
    find_dependency(Boost 1.58 QUIET REQUIRED COMPONENTS system filesystem)
    add_compile_definitions(RT_USE_BOOSTFS)
else()
    find_dependency(Filesystem QUIET REQUIRED)
endif()

find_dependency(spdlog 1.9.0 CONFIG REQUIRED)

# rt::core PUBLIC-links educelab::core, so consumers need it on the system
find_dependency(EduceLabCore 0.3.0 CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/@targets_export_name@.cmake")
check_required_components("@PROJECT_NAME@")
